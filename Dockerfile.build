# Builds libqemu-xtensa.so for Debian bookworm hosts (the testbench sim image):
#
#   docker buildx build -f Dockerfile.build --output type=local,dest=<dir> .
FROM debian:bookworm AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential ca-certificates git ninja-build pkg-config python3 python3-venv perl \
    flex bison libglib2.0-dev libgcrypt20-dev libslirp-dev libpixman-1-dev libfdt-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
COPY . /src
RUN /src/build_libqemu-xtensa.sh /build

FROM scratch
COPY --from=build /build/libqemu-xtensa.so /
